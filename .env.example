# Copy to .env (git-ignored) and fill in real values. NEVER commit .env.

# Neon / Postgres connection string — used by the postgres MCP server in .mcp.json
NEON_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS credentials (scanner / deploy)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Model API key (Anthropic)
ANTHROPIC_API_KEY=

# GitHub token for the github MCP server (repo scope)
GITHUB_TOKEN=
